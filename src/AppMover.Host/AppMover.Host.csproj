<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\AppMover.Detection\AppMover.Detection.csproj" />
    <ProjectReference Include="..\AppMover.Deployment\AppMover.Deployment.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- build.sh passes a signed copy when signing; otherwise the unsigned reproducible build is embedded. -->
    <SevenZipExe Condition="'$(SevenZipExe)' == ''">..\..\third_party\7-Zip\7zz.exe</SevenZipExe>
  </PropertyGroup>
  <ItemGroup>
    <!-- 7-Zip built with the NSIS script decompiler (tools/build-7zip.sh), extracted at first use. -->
    <EmbeddedResource Include="$(SevenZipExe)" LogicalName="AppMover.Tools.7zz.exe" />
    <!-- Native DLL of TraceEvent for the x64 kernel session, extracted at first use (see KernelTraceControlLoader). -->
    <EmbeddedResource Include="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\amd64\KernelTraceControl.dll"
                      LogicalName="AppMover.Tools.KernelTraceControl.dll" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AppMover.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
