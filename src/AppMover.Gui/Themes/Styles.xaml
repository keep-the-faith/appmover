<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gui="clr-namespace:AppMover.Gui">

    <SolidColorBrush x:Key="AccentBrush" Color="#2B5797" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <gui:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <gui:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <gui:SeverityToBrushConverter x:Key="SeverityToBrush" />

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E6EB" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="gui:DataGridStarColumns.RefreshOnShow" Value="True" />
    </Style>

    <!-- Issues: severity in color, message, location. -->
    <DataTemplate x:Key="IssueTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,1">
            <TextBlock Text="●" Margin="0,0,6,0" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
            <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Message, Mode=OneWay}" />
                <Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- Semi-transparent layer shown during long operations (DataContext: a PageViewModel). -->
    <Style x:Key="BusyOverlay" TargetType="Border">
        <Setter Property="Background" Value="#C0FFFFFF" />
        <Setter Property="Visibility" Value="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Style>
</ResourceDictionary>
